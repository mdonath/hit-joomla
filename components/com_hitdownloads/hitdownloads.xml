<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
 
    <name>HIT Downloads</name>

    <author>Martijn Donath</author>
    <creationDate>October 2025</creationDate>
    <copyright>(C) Martijn Donath / HIT Scouting Nederland</copyright>
    <license>LGPL</license>
    <authorEmail>martijn.donath@scouting.nl</authorEmail>
    <authorUrl>https://github.com/mdonath/hit-joomla</authorUrl>
    <version>1.0.0</version>
    <description>COM_HITDOWNLOADS_DESCRIPTION</description>

    <namespace path="src">HITScoutingNL\Component\HitDownloads</namespace>

    
    <!-- Site Main File Copy Section -->
    <files folder="site">
        <filename>index.html</filename>
        <!-- <folder>language</folder> -->
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>

    <media folder="media" destination="com_hitdownloads">
        <filename>index.html</filename>
        <!-- <filename>joomla.asset.json</filename> -->
        <!-- <folder>images</folder> -->
        <!-- <folder>css</folder> -->
        <!-- <folder>js</folder> -->
    </media>

    <administration>
        <!-- Administration Menu Section -->
        <menu>COM_HITDOWNLOADS_MENU</menu>
        <submenu>
            <menu view="info">COM_HITDOWNLOADS_SUBMENU_INFO</menu>
        </submenu>

        <!-- Administration Main File Copy Section -->
        <files folder="admin">
            <filename>access.xml</filename>
            <filename>config.xml</filename>
            <filename>index.html</filename>
            <!-- <folder>forms</folder>
            <folder>libraries</folder>
            <folder>sql</folder> -->
            <folder>services</folder>
            <folder>src</folder>
            <folder>tmpl</folder>
        </files>

        <languages folder="admin">
            <!-- <language tag="en-GB">language/en-GB/en-GB.com_hitdownloads.ini</language>
            <language tag="en-GB">language/en-GB/en-GB.com_hitdownloads.sys.ini</language> -->
            <language tag="nl-NL">language/nl-NL/nl-NL.com_hitdownloads.ini</language>
            <language tag="nl-NL">language/nl-NL/nl-NL.com_hitdownloads.sys.ini</language>
        </languages>
    </administration>
 
</extension>