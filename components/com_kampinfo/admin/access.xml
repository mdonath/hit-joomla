<?xml version="1.0" encoding="utf-8" ?>
<access component="com_kampinfo">

    <section name="component">
        <!-- Wie mag de component level permissions via de 'Options' toolbar button bewerken? -->
        <action name="core.admin"           title="JACTION_ADMIN" />
        <!-- Kun je de instellingen van KampInfo wijzigen? -->
        <action name="core.options"         title="JACTION_OPTIONS"/>
        <!-- Kun je gebruik maken van KampInfo? -->
        <action name="core.manage"          title="JACTION_MANAGE" />

        <action name="hitproject.create"    title="Maak HIT Project" />
        <action name="hitproject.edit"      title="Bewerk HIT Project" />
        <action name="hitproject.delete"    title="Verwijder HIT Project" />

        <action name="hitsite.create"       title="Maak HIT Plaats" />
        <action name="hitsite.edit"         title="Bewerk HIT Plaats" />
        <action name="hitsite.edit.state"   title="Publiceer HIT Plaats" />
        <action name="hitsite.delete"       title="Verwijder HIT Plaats" />

        <action name="hitcamp.create"       title="Maak HIT Kamponderdeel" />
        <action name="hitcamp.edit"         title="Bewerk HIT Kamponderdeel" />
        <action name="hitcamp.edit.state"   title="Publiceer HIT Kamponderdeel" />
