<?xml version="1.0" encoding="UTF-8"?>
<form
        addfieldprefix="HITScoutingNL\Component\KampInfo\Administrator\Field"
>
    <fieldset
            name="algemeen"
            label="Algemeen"
    >
        <field  name="id"
                type="hidden"
                default="0"
                readonly="true"
                class="readonly"
        />
        <field  name="jaar"
                type="number"
                label="COM_KAMPINFO_HITPROJECT_JAAR_LABEL"
                description="COM_KAMPINFO_HITPROJECT_JAAR_DESC"
                required="true"
                default="2000"
                class="validate-numeric"
        />
    </fieldset>
    <fieldset
            name="inschrijving"
            label="Inschrijving"
    >
        <field  name="inschrijvingStartdatum"
                type="calendar"
                label="COM_KAMPINFO_HITPROJECT_INSCHRIJVING_START_LABEL"
                description="COM_KAMPINFO_HITPROJECT_INSCHRIJVING_START_DESC"
                size="20"
                maxlength="19"
                format="%d-%m-%Y %H:%M"
                required="true"
                default=""
                filter="SERVER_UTC"
        />
        <field  name="loterijStartdatum"
                type="calendar"
                label="COM_KAMPINFO_HITPROJECT_LOTERIJ_START_LABEL"
                description="COM_KAMPINFO_HITPROJECT_LOTERIJ_START_DESC"
                size="20"
                maxlength="19"
                format="%d-%m-%Y %H:%M"
                required="true"
                default=""
                filter="SERVER_UTC"
        />
        <field  name="loterijEinddatum"
                type="calendar"
                label="COM_KAMPINFO_HITPROJECT_LOTERIJ_EIND_LABEL"
                description="COM_KAMPINFO_HITPROJECT_LOTERIJ_EIND_DESC"
                size="20"
                maxlength="19"
                format="%d-%m-%Y %H:%M"
                required="true"
                default=""
                filter="SERVER_UTC"
        />
        <field  name="inschrijvingEinddatum"
                type="calendar"
                label="COM_KAMPINFO_HITPROJECT_INSCHRIJVING_EIND_LABEL"
                description="COM_KAMPINFO_HITPROJECT_INSCHRIJVING_EIND_DESC"
                size="20"
                maxlength="19"
                format="%d-%m-%Y %H:%M"
                required="true"
                default=""
                filter="SERVER_UTC"
        />
        <field  name="inschrijvingWijzigenTotDatum"
                type="calendar"
                label="COM_KAMPINFO_HITPROJECT_INSCHRIJVING_WIJZIGENTOT_LABEL"
                description="COM_KAMPINFO_HITPROJECT_INSCHRIJVING_WIJZIGENTOT_DESC"
                format="%d-%m-%Y"
                required="true"
                default=""
                filter="SERVER_UTC"
        />
        <field  name="inschrijvingKosteloosAnnulerenDatum"
                type="calendar"
                label="COM_KAMPINFO_HITPROJECT_INSCHRIJVING_KOSTELOOSANNULEREN_LABEL"
                description="COM_KAMPINFO_HITPROJECT_INSCHRIJVING_KOSTELOOSANNULEREN_DESC"
                format="%d-%m-%Y"
                required="true"
                default=""
                filter="SERVER_UTC"
        />
        <field  name="inschrijvingGeenRestitutieDatum"
                type="calendar"
                label="COM_KAMPINFO_HITPROJECT_INSCHRIJVING_GEENRESTITUTIE_LABEL"
                description="COM_KAMPINFO_HITPROJECT_INSCHRIJVING_GEENRESTITUTIE_DESC"
                format="%d-%m-%Y"
                required="true"
                default=""
                filter="SERVER_UTC"
        />
        <field  name="inningsdatum"
                type="calendar"
                label="COM_KAMPINFO_HITPROJECT_INNINGSDATUM_LABEL"
                description="COM_KAMPINFO_HITPROJECT_INNINGSDATUM_DESC"
                format="%d-%m-%Y"
                required="true"
                default=""
                filter="SERVER_UTC"
        />
    </fieldset>
    <fieldset
            name="pasen"
            label="Pasen"
    >
        <field  name="vrijdag"
                type="calendar"
                label="COM_KAMPINFO_HITPROJECT_VRIJDAG_LABEL"
                description="COM_KAMPINFO_HITPROJECT_VRIJDAG_DESC"
                format="%d-%m-%Y"
                required="true"
                default=""
                filter="SERVER_UTC"
        />
        <field  name="maandag"
                type="calendar"
                label="COM_KAMPINFO_HITPROJECT_MAANDAG_LABEL"
                description="COM_KAMPINFO_HITPROJECT_MAANDAG_DESC"
                format="%d-%m-%Y"
                required="true"
                default=""
                filter="SERVER_UTC"
        />
    </fieldset>
    <fieldset
            name="teksten"
            label="Teksten"
    >
        <field  name="thema"
                type="text"
                label="Thema"
                description="Het motto/thema/leus/spreuk op het naambandje"
                maxlength="255"
                size="30"
                default=""
        />
        <field  name="ouderkind"
                type="editor"
                label="Ouder kind kamp"
                description="Deze tekst wordt standaard toegevoegd bij alle ouder-kind kampen"
                required="true"
                filter="safehtml"
        />
    </fieldset>
    <fieldset
            name="website"
            label="Website"
    >
        <field  name="zichtbaarVanaf"
                type="calendar"
                showtime="true"
                filter="SERVER_UTC"
                format="%d-%m-%Y %H:%M"
                label="Kampen zichtbaar vanaf"
                description="Vanaf dit moment staan de kampen van dit jaar op de site. Leeg = meteen."
        />
        <field  name="courantOnlineVanaf"
                type="calendar"
                showtime="true"
                filter="SERVER_UTC"
                format="%d-%m-%Y %H:%M"
                label="Courant online vanaf"
        />
        <field  name="courantLink"
                type="phocadownloadfile"
                label="Link naar de Courant (pdf)"
                description="Selecteer het pdf-bestand van de Courant"
                required="false"
                default=""
                filter="string">
                <option value="">JNONE</option>
        </field>
        <field  name="courantVoorkant"
                type="media"
                label="Voorkant Courant"
        />
        <field  name="tweedeRondeTekst"
                type="text"
                label="Tekst 2e ronde (mag leeg)"
        />
    </fieldset>

</form>