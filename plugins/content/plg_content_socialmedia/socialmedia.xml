<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="content" method="upgrade">

    <description>PLG_CONTENT_SOCIALMEDIA_XML_DESCRIPTION</description>

    <name>plg_content_socialmedia</name>
    <version>3.1</version>

    <creationDate>September 2025</creationDate>
    <copyright>2025</copyright>
    <author>Martijn Donath</author>
    <namespace path="src">HITScoutingNL\Plugin\Content\SocialMedia</namespace>

    <files>
        <folder plugin="socialmedia">services</folder>
        <folder>language</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>

    <languages>
        <language tag="en-GB">language/en-GB/plg_content_socialmedia.ini</language>
        <language tag="en-GB">language/en-GB/plg_content_socialmedia.sys.ini</language>
        <language tag="nl-NL">language/nl-NL/plg_content_socialmedia.ini</language>
        <language tag="nl-NL">language/nl-NL/plg_content_socialmedia.sys.ini</language>
    </languages>

    <media folder="media" destination="plg_content_socialmedia">
        <folder>images</folder>
    </media>

</extension>
